{
  "docker": {
    "services": {
      "backend": {
        "build": ".",
        "ports": ["5000:5000"],
        "depends_on": ["mysql"]
      },
      "mysql": {
        "image": "mysql:8",
        "environment": {
          "MYSQL_ROOT_PASSWORD": "root",
          "MYSQL_DATABASE": "school_db"
        },
        "ports": ["3306:3306"]
      }
    }
  }
}
