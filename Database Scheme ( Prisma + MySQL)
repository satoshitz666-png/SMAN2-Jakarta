generator client {
provider = "prisma-client-js"
}

datasource db {
provider = "mysql"
url      = env("DATABASE_URL")
}

model User {
id        Int      @id @default(autoincrement())
name      String
email     String   @unique
password  String
role      String   // admin, superadmin, guru
status    Boolean  @default(true)
createdAt DateTime @default(now())

berita    Berita[]
}

model Berita {
id        Int      @id @default(autoincrement())
title     String
content   String
thumbnail String?
status    String   // draft, publish
createdAt DateTime @default(now())

authorId  Int
author    User     @relation(fields: [authorId], references: [id])
}

model Siswa {
id         Int    @id @default(autoincrement())
nama       String
nisn       String @unique
jurusanId  Int
jurusan    Jurusan @relation(fields: [jurusanId], references: [id])
}

model Jurusan {
id     Int    @id @default(autoincrement())
nama   String
siswa  Siswa[]
}

model Pendaftar {
id        Int    @id @default(autoincrement())
nama      String
nisn      String
asalSekolah String
status    String
}
