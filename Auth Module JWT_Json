{
  "auth": {
    "login": {
      "endpoint": "POST /api/auth/login",
      "request": {
        "email": "string",
        "password": "string"
      },
      "response": {
        "token": "jwt_token",
        "user": {
          "id": "int",
          "role": "string"
        }
      }
    },
    "middleware": {
      "type": "jwt",
      "header": "Authorization: Bearer <token>",
      "verify": "JWT_SECRET"
    }
  }
}
